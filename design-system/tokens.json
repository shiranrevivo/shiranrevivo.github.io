  "bg": "#0B0408",
  "bg-2": "#12060F",
  "surface": "#180914",
  "pink": "#FF7BF8",
  "pink-hover": "#FFA3FA",
  "pink-soft": "#FFC4FC",
  "pink-dim": "#93408F",
  "pink-deep": "#3B1440",
  "text": "#F7C4EE",
  "muted": "#B07AA5",
  "line": "rgba(255, 123, 248, .18)",
  "line-strong": "rgba(255, 123, 248, .45)",
  "yellow": "#FFE15C",
  "paper": "#F6EFF2",
  "kraft": "#F2D7A0",
  "amber": "#E8A33A",
  "glow": "0 0 4px rgba(255, 123, 248, .65), 0 0 18px rgba(255, 123, 248, .3)",
